# Public address of the deployed platform
APP_URL=https://your-app.vercel.app

# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared platform password. Every login ID uses this password.
ADMIN_PASSWORD=Admin@2026

# Long random strings used to sign login sessions and the MCP connector
SESSION_SECRET=change-me-to-a-long-random-string
MCP_TOKEN=change-me-to-a-long-random-string
